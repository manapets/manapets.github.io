---
const slides = [
  {
    image: '/images/hero/hero-1.svg',
    eyebrow: 'Ofertas de la semana',
    title: 'Hasta 25% OFF en alimentos seleccionados',
    text: 'Secos y húmedos de las mejores marcas, con entrega en el día en Gran Mendoza.',
    cta: { label: 'Ver ofertas', href: '/collections/liquidacion' },
  },
  {
    image: '/images/hero/hero-2.svg',
    eyebrow: 'Kg de regalo',
    title: 'Comprá 7,5kg y llevate kilos de regalo',
    text: 'En las bolsas grandes de alimentos seleccionados. Aprovechá antes de que se terminen.',
    cta: { label: 'Ver promos', href: '/productos/?promo=kg' },
  },
];

const destacados = [
  {
    image: '/images/promos/destacados.webp',
    title: 'Envío gratis',
    text: 'En compras superiores a $30.000',
    href: '/productos/',
  },
  {
    image: '/images/promos/cuotas.webp',
    title: '3 cuotas sin interés',
    text: 'En compras superiores a $150.000',
    href: '/productos/',
  },
];
---

<section class="container-page py-6">
  <div class="grid gap-4 lg:grid-cols-12">
    <div class="lg:col-span-8">
      <div class="relative overflow-hidden rounded-[var(--radius-xl)]" data-hero-carousel>
        <div class="relative h-[320px] sm:h-[420px]">
          {
            slides.map((slide, i) => (
              <article
                data-hero-slide
                data-index={i}
                class:list={[
                  'absolute inset-0 transition-opacity duration-500',
                  i === 0 ? 'opacity-100' : 'pointer-events-none opacity-0',
                ]}
                aria-hidden={i !== 0}
              >
                <img src={slide.image} alt="" class="absolute inset-0 h-full w-full object-cover" width="1600" height="900" loading={i === 0 ? 'eager' : 'lazy'} />
                <div class="absolute inset-0 bg-gradient-to-t from-foreground/70 via-foreground/20 to-transparent"></div>
                <div class="relative flex h-full max-w-lg flex-col justify-end gap-3 p-6 sm:p-10">
                  <span class="pill w-fit bg-brand-primary text-foreground">{slide.eyebrow}</span>
                  <h2 class="text-2xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl">{slide.title}</h2>
                  <p class="max-w-md text-sm text-white/85 sm:text-base">{slide.text}</p>
                  <a href={slide.cta.href} class="btn-yellow mt-1 w-fit px-6 py-3">{slide.cta.label}</a>
                </div>
              </article>
            ))
          }
        </div>

        <div class="absolute bottom-4 right-4 flex gap-2" data-hero-dots>
          {
            slides.map((_, i) => (
              <button
                type="button"
                data-hero-dot
                data-index={i}
                class:list={['h-2.5 rounded-full transition-all', i === 0 ? 'w-8 bg-white' : 'w-2.5 bg-white/50']}
                aria-label={`Ir al slide ${i + 1}`}
              ></button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="lg:col-span-4">
      <h2 class="mb-3 text-lg font-extrabold tracking-tight">Destacados</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
        {
          destacados.map((card) => (
            <a href={card.href} class="group relative flex h-40 items-end overflow-hidden rounded-[var(--radius-lg)] lg:h-[202px]">
              <img src={card.image} alt="" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" width="800" height="800" loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-foreground/75 to-transparent"></div>
              <div class="relative p-5">
                <p class="text-base font-extrabold text-white">{card.title}</p>
                <p class="text-xs text-white/80">{card.text}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-hero-carousel]');
  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-hero-slide]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLElement>('[data-hero-dot]'));
    let index = 0;
    let timer: number | undefined;

    function show(next: number): void {
      index = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('opacity-100', active);
        slide.classList.toggle('opacity-0', !active);
        slide.classList.toggle('pointer-events-none', !active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('w-8', i === index);
        dot.classList.toggle('bg-white', i === index);
        dot.classList.toggle('w-2.5', i !== index);
        dot.classList.toggle('bg-white/50', i !== index);
      });
    }

    function start(): void {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      stop();
      timer = window.setInterval(() => show(index + 1), 5500);
    }

    function stop(): void {
      if (timer) window.clearInterval(timer);
    }

    dots.forEach((dot) =>
      dot.addEventListener('click', () => {
        show(Number(dot.dataset.index ?? 0));
        start();
      }),
    );
    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    start();
  }
</script>
