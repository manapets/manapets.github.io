---
import { STORE } from '../config';
---

<div
  data-drawer-overlay
  class="pointer-events-none fixed inset-0 z-40 bg-foreground/50 opacity-0"
  aria-hidden="true"
></div>

<aside
  data-cart-drawer
  class="fixed right-0 top-0 z-50 flex h-full w-full max-w-md translate-x-full flex-col bg-white shadow-2xl"
  role="dialog"
  aria-modal="true"
  aria-label="Carrito de compras"
>
  <header class="flex items-center justify-between border-b border-border px-5 py-4">
    <h2 class="text-base font-bold">Tu carrito</h2>
    <button
      type="button"
      data-cart-close
      class="grid h-9 w-9 place-items-center rounded-full text-muted transition-colors hover:bg-muted-bg hover:text-foreground"
      aria-label="Cerrar carrito"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
  </header>

  <div class="flex-1 overflow-y-auto px-5">
    <ul data-cart-items class="hidden divide-y divide-border"></ul>

    <div data-cart-empty class="flex h-full flex-col items-center justify-center gap-3 py-16 text-center">
      <span class="grid h-14 w-14 place-items-center rounded-full bg-muted-bg text-muted">
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.4 12.3a2 2 0 0 0 2 1.7h7.2a2 2 0 0 0 2-1.7L21 8H6" /><circle cx="9.5" cy="20" r="1.5" /><circle cx="18" cy="20" r="1.5" /></svg>
      </span>
      <p class="font-semibold">Todavía no hay nada acá.</p>
      <p class="text-sm text-muted">Agregá productos para empezar tu pedido.</p>
      <button type="button" data-cart-close class="btn-outline mt-2">Ver productos</button>
    </div>
  </div>

  <footer data-cart-footer class="hidden border-t border-border">
    <div class="space-y-3 border-b border-border px-5 py-4">
      <div data-progress-envio>
        <p data-progress-envio-text class="text-xs font-semibold text-foreground"></p>
        <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted-bg">
          <span data-progress-envio-bar class="block h-full rounded-full bg-success transition-[width] duration-300" style="width:0%"></span>
        </div>
      </div>
      <div data-progress-cuotas>
        <p data-progress-cuotas-text class="text-xs font-semibold text-muted"></p>
        <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted-bg">
          <span data-progress-cuotas-bar class="block h-full rounded-full bg-brand-secondary transition-[width] duration-300" style="width:0%"></span>
        </div>
      </div>
    </div>

    <div class="px-5 py-4">
      <form data-discount-form class="flex gap-2" autocomplete="off">
        <label class="sr-only" for="discount-code">Código de descuento</label>
        <input id="discount-code" data-discount-input type="text" class="input" placeholder="Código de descuento (PLUSPET10)" />
        <button type="submit" class="btn-outline shrink-0">Aplicar</button>
      </form>
      <p data-discount-msg class="mt-2 hidden text-xs font-semibold"></p>

      <dl class="mt-4 space-y-1.5 text-sm">
        <div class="flex items-center justify-between">
          <dt class="text-muted">Subtotal</dt>
          <dd data-cart-subtotal class="font-semibold tabular-nums">—</dd>
        </div>
        <div data-cart-discount-row class="flex items-center justify-between text-brand-secondary" hidden>
          <dt>Descuento</dt>
          <dd data-cart-discount class="font-semibold tabular-nums">—</dd>
        </div>
        <div class="flex items-center justify-between border-t border-border pt-1.5">
          <dt class="font-bold">Total</dt>
          <dd data-cart-total class="text-lg font-extrabold tabular-nums">—</dd>
        </div>
      </dl>

      <p class="mt-3 flex items-start gap-1.5 rounded-[var(--radius)] bg-brand-secondary-tint px-3 py-2 text-xs text-brand-secondary" data-cart-reintegro></p>
      <p class="mt-2 text-xs text-muted">{STORE.shippingNote}</p>

      <a data-cart-checkout href="#" target="_blank" rel="noopener" class="btn-whatsapp mt-4 w-full py-3">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20Z" /></svg>
        Ir a pagar
      </a>
    </div>
  </footer>
</aside>
