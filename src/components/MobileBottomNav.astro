---
import { STORE } from '../config';

const items = [
  { label: 'Inicio', href: '/', icon: 'home' },
  { label: 'Categorías', href: '#', icon: 'grid', action: 'menu' },
  { label: 'Carrito', href: '#', icon: 'cart', action: 'cart' },
  { label: 'WhatsApp', href: `https://wa.me/${STORE.whatsappPhone}`, icon: 'whatsapp', external: true },
  { label: 'Mi cuenta', href: '/cuenta', icon: 'user' },
];
---

<nav class="fixed bottom-0 left-0 right-0 z-30 border-t border-border bg-white/95 backdrop-blur lg:hidden" aria-label="Navegación inferior">
  <div class="grid grid-cols-5">
    {
      items.map((item) => (
        <a
          href={item.href}
          class="relative flex flex-col items-center gap-0.5 py-2 text-[0.65rem] font-semibold text-muted transition-colors hover:text-brand-secondary"
          data-menu-open={item.action === 'menu' ? true : undefined}
          data-cart-open={item.action === 'cart' ? true : undefined}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener' : undefined}
        >
          <span class="grid h-6 w-6 place-items-center">
            {item.icon === 'home' && <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /></svg>}
            {item.icon === 'grid' && <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>}
            {item.icon === 'cart' && <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.4 12.3a2 2 0 0 0 2 1.7h7.2a2 2 0 0 0 2-1.7L21 8H6" /><circle cx="9.5" cy="20" r="1.5" /><circle cx="18" cy="20" r="1.5" /></svg>}
            {item.icon === 'whatsapp' && <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20Z" /></svg>}
            {item.icon === 'user' && <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" /></svg>}
          </span>
          <span>{item.label}</span>
          {item.action === 'cart' && (
            <span data-cart-count class="absolute right-[22%] top-1 hidden min-w-4 rounded-full bg-brand-secondary px-1 text-center text-[0.6rem] font-bold leading-4 text-white">0</span>
          )}
        </a>
      ))
    }
  </div>
</nav>
