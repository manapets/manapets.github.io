---
import { COLLECTIONS } from '../lib/nav';
---

<section class="container-page py-10">
  <div class="grid gap-4 sm:grid-cols-3">
    {
      COLLECTIONS.map((collection) => (
        <a href={collection.href} class="group relative flex h-44 items-end overflow-hidden rounded-[var(--radius-xl)]">
          <img src={collection.image} alt="" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" width="1000" height="800" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-foreground/80 to-transparent"></div>
          <div class="relative p-5">
            <h3 class="text-xl font-extrabold text-white">{collection.title}</h3>
            <p class="text-sm text-white/80">{collection.teaser}</p>
            <span class="mt-2 inline-block text-sm font-semibold text-brand-primary group-hover:underline">Ver todos →</span>
          </div>
        </a>
      ))
    }
  </div>
</section>
