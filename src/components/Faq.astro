---
import { getCollection } from 'astro:content';

// Las preguntas se editan desde el panel: /admin → Preguntas frecuentes.
const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);
---

<section id="preguntas" class="container-page scroll-mt-24 py-12">
  <h2 class="mb-6 text-2xl font-extrabold tracking-tight">Preguntas frecuentes</h2>
  <div class="mx-auto max-w-3xl divide-y divide-border overflow-hidden rounded-[var(--radius-xl)] border border-border bg-white">
    {
      faqs.map((faq) => (
        <details id={`faq-${faq.data.id}`} class="group scroll-mt-24">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-semibold sm:text-base">
            {faq.data.question}
            <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-muted transition-transform group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
          </summary>
          <p class="px-5 pb-5 text-sm leading-relaxed text-muted">{faq.data.answer}</p>
        </details>
      ))
    }
  </div>
</section>
