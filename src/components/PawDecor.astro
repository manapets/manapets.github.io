---
import Paw from './Paw.astro';

/**
 * Huellas moradas flotando suavemente sobre el fondo blanco.
 * Puramente decorativo: `pointer-events-none` + `aria-hidden`.
 */
const paws = [
  { top: '12%', left: '4%', size: 54, rot: '-18deg', delay: '0s', opacity: 0.14 },
  { top: '30%', right: '6%', size: 42, rot: '22deg', delay: '1.2s', opacity: 0.12 },
  { top: '58%', left: '7%', size: 36, rot: '10deg', delay: '2.1s', opacity: 0.12 },
  { top: '74%', right: '10%', size: 58, rot: '-14deg', delay: '0.6s', opacity: 0.13 },
  { top: '88%', left: '18%', size: 30, rot: '28deg', delay: '1.7s', opacity: 0.11 },
];
---

<div class="paw-decor" aria-hidden="true">
  {
    paws.map((p) => (
      <span
        class="paw-float"
        style={`top:${p.top};left:${p.left ?? 'auto'};right:${p.right ?? 'auto'};opacity:${p.opacity};--paw-rot:${p.rot};animation-delay:${p.delay}`}
      >
        <Paw size={p.size} />
      </span>
    ))
  }
</div>
