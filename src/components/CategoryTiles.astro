---
const tiles = [
  {
    title: 'Perros',
    subtitle: 'Cachorro · Adulto · Senior',
    image: '/images/categories/perros.svg',
    href: '/perros',
  },
  {
    title: 'Gatos',
    subtitle: 'Cachorro · Adulto · Castrado',
    image: '/images/categories/gatos.svg',
    href: '/gatos',
  },
];
---

<section class="container-page py-10">
  <div class="grid gap-4 sm:grid-cols-2">
    {
      tiles.map((tile) => (
        <a href={tile.href} class="group relative flex h-48 items-center overflow-hidden rounded-[var(--radius-xl)] sm:h-56">
          <img src={tile.image} alt="" class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" width="1000" height="800" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-r from-foreground/75 via-foreground/30 to-transparent"></div>
          <div class="relative px-7">
            <h2 class="text-3xl font-extrabold tracking-tight text-white">{tile.title}</h2>
            <p class="mt-1 text-sm text-white/85">{tile.subtitle}</p>
            <span class="btn-yellow mt-4 w-fit">Ver productos</span>
          </div>
        </a>
      ))
    }
  </div>
</section>
