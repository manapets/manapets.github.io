---
// src/pages/productos/index.astro
// Listado de productos leyendo archivos JSON generados por Decap CMS
// en src/content/productos/

const products = import.meta.glob('../../content/productos/*.json', { eager: true });

const productoList = Object.entries(products)
  .map(([path, mod]) => ({
    ...(mod as { default: any }).default,
    _path: path,
  }))
  .filter((p: any) => p.activo !== false)
  .sort((a: any, b: any) => String(a.title ?? '').localeCompare(String(b.title ?? ''), 'es'));
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Productos - ManáPets</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap"
    rel="stylesheet"
  />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Nunito', sans-serif; background: #f8fafc; color: #0f172a; line-height: 1.5; }
    a { color: #0D2B3E; text-decoration: none; }
    a:hover { text-decoration: underline; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
    header { background: #0D2B3E; color: #fff; padding: 1rem 0; }
    header .container { display: flex; justify-content: space-between; align-items: center; }
    header h1 { font-family: 'Fredoka', sans-serif; font-size: 1.5rem; }
    nav a { color: #fff; margin-left: 1.5rem; font-weight: 600; }
    .hero { padding: 3rem 0; text-align: center; background: #fff; }
    .hero h2 { font-family: 'Fredoka', sans-serif; font-size: 2.5rem; margin-bottom: 0.5rem; }
    .hero p { color: #64748b; font-size: 1.1rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.5rem; padding: 2rem 0; }
    .card { background: #fff; border-radius: 1rem; overflow: hidden; border: 1px solid #e2e8f0; transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column; }
    .card:hover { transform: translateY(-4px); box-shadow: 0 12px 24px -4px rgba(0,0,0,0.1); }
    .card-img { width: 100%; height: 220px; object-fit: cover; background: #f1f5f9; }
    .card-body { padding: 1rem; flex: 1; display: flex; flex-direction: column; }
    .card-brand { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; font-weight: 700; margin-bottom: 0.25rem; }
    .card-title { font-family: 'Fredoka', sans-serif; font-size: 1rem; font-weight: 700; margin-bottom: 0.5rem; color: #0f172a; }
    .card-price { display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.5rem; }
    .price-current { font-size: 1.25rem; font-weight: 800; color: #0D2B3E; }
    .price-old { font-size: 0.9rem; color: #94a3b8; text-decoration: line-through; }
    .badge-promo { display: inline-block; background: #fee2e2; color: #991b1b; font-size: 0.7rem; font-weight: 800; padding: 0.15rem 0.5rem; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
    .badge-stock { font-size: 0.75rem; font-weight: 700; margin-bottom: 0.75rem; }
    .stock-ok { color: #16a34a; }
    .stock-low { color: #ca8a04; }
    .stock-out { color: #dc2626; }
    .btn { display: inline-block; width: 100%; background: #0D2B3E; color: #fff; border: none; padding: 0.75rem; border-radius: 0.5rem; font-weight: 700; cursor: pointer; text-align: center; }
    .btn:hover { background: #0b2232; }
    .btn:disabled { background: #cbd5e1; cursor: not-allowed; }
    .empty { text-align: center; padding: 4rem; color: #64748b; }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <h1><a href="/" style="color:inherit; text-decoration:none;">ManáPets</a></h1>
      <nav>
        <a href="/admin">Administrador</a>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="container">
      <h2>Todos los productos</h2>
      <p>Alimento, camas, higiene y snacks para perros y gatos.</p>
    </div>
  </section>

  <div class="container">
    {(productoList as any[]).length > 0 ? (
      <>
        <div class="grid">
          {(productoList as any[]).map((p) => (
            <article class="card">
              {p.imagen ? (
                <img src={p.imagen} alt={p.title} class="card-img" />
              ) : (
                <div class="card-img" style="display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:0.85rem;">Sin imagen</div>
              )}
              <div class="card-body">
                {p.promocion && p.precio_venta ? (
                  <span class="badge-promo">Promoción</span>
                ) : null}
                <span class="card-brand">{p.categoria ?? ''}</span>
                <h3 class="card-title">{p.title}</h3>
                <div class="card-price">
                  {p.promocion && p.precio_venta ? (
                    <>
                      <span class="price-current">${Number(p.precio_venta)}</span>
                      <span class="price-old">${Number(p.precio)}</span>
                    </>
                  ) : (
                    <span class="price-current">${Number(p.precio)}</span>
                  )}
                </div>
                <span class={`badge-stock ${Number(p.stock) <= 0 ? 'stock-out' : Number(p.stock) <= 10 ? 'stock-low' : 'stock-ok'}`}>
                  {Number(p.stock) <= 0 ? 'Sin stock' : Number(p.stock) <= 10 ? `Quedan ${p.stock}` : `Stock: ${p.stock}`}
                </span>
                <button class="btn" disabled={Number(p.stock) <= 0}>
                  {Number(p.stock) > 0 ? 'Comprar' : 'Sin stock'}
                </button>
              </div>
            </article>
          ))}
        </div>
        <p style="text-align:center; margin-top:1rem; color:#64748b;">
          {(productoList as any[]).length} productos disponibles
        </p>
      </>
    ) : (
      <div class="empty">
        <h2>No hay productos cargados</h2>
        <p>Ingresá al <a href="/admin">administrador</a> para agregar productos.</p>
      </div>
    )}
  </div>
</body>
</html>