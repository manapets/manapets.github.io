---
interface Props {
  images: string[];
  alt: string;
  badge?: string;
}

const { images, alt, badge } = Astro.props;
const multi = images.length > 1;
---

<div data-gallery class="gallery" data-images={JSON.stringify(images)}>
  <div class="relative overflow-hidden rounded-2xl border border-neutral-200 bg-neutral-100">
    <div
      data-gallery-main
      class="gallery-main group aspect-square"
      role="button"
      tabindex="0"
      aria-label={`Ampliar imagen de ${alt}`}
    >
      <img
        data-gallery-image
        src={images[0]}
        alt={alt}
        width="1200"
        height="1200"
        class="gallery-img h-full w-full object-cover"
        fetchpriority="high"
        decoding="async"
      />
      {badge && <span class="absolute left-4 top-4 rounded-full bg-neutral-900 px-3 py-1 text-xs font-bold text-white">{badge}</span>}
      <span class="pointer-events-none absolute right-4 top-4 flex items-center gap-1.5 rounded-full bg-white/85 px-3 py-1.5 text-xs font-semibold text-neutral-700 backdrop-blur">
        <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3M11 8v6M8 11h6" />
        </svg>
        Zoom
      </span>
    </div>
  </div>

  {
    multi && (
      <div data-gallery-thumbs class="mt-3 grid grid-cols-3 gap-3">
        {images.map((src, i) => (
          <button
            type="button"
            data-gallery-thumb
            data-index={i}
            class:list={[
              'thumb relative aspect-square overflow-hidden rounded-xl border-2 bg-neutral-100 transition-colors',
              i === 0 ? 'border-neutral-900' : 'border-transparent hover:border-neutral-300',
            ]}
            aria-label={`Ver imagen ${i + 1} de ${images.length}`}
          >
            <img src={src} alt="" width="300" height="300" loading="lazy" decoding="async" class="h-full w-full object-cover" />
          </button>
        ))}
      </div>
    )
  }

  <!-- Lightbox -->
  <div data-lightbox class="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label={`Imagen ampliada de ${alt}`}>
  <button type="button" data-lightbox-close class="lb-btn lb-close" aria-label="Cerrar">
    <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </button>

  {
    multi && (
      <>
        <button type="button" data-lightbox-prev class="lb-btn lb-prev" aria-label="Imagen anterior">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" data-lightbox-next class="lb-btn lb-next" aria-label="Imagen siguiente">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </>
    )
  }

  <div class="lb-stage">
    <img data-lightbox-image src={images[0]} alt={alt} class="lb-image" draggable="false" />
  </div>

  <div data-lightbox-counter class="lb-counter">1 / {images.length}</div>
    <p class="lb-help">Clic para acercar · arrastrá para mover · Esc para cerrar</p>
  </div>
</div>

<style>
  .gallery-main {
    cursor: zoom-in;
  }
  .gallery-img {
    transition: transform 0.18s ease-out;
    will-change: transform;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(10, 10, 10, 0.92);
    overflow: hidden;
  }
  .lightbox.is-open {
    display: flex;
  }

  .lb-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(92vw, 1100px);
    height: min(88vh, 1100px);
    overflow: hidden;
    touch-action: none;
  }
  .lb-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transform-origin: center center;
    transition: transform 0.15s ease-out;
    user-select: none;
    cursor: zoom-in;
  }
  .lb-image.is-zoomed {
    cursor: zoom-out;
    transition: none;
  }
  .lb-image.is-dragging {
    transition: none;
  }

  .lb-btn {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    transition: background 0.15s ease;
  }
  .lb-btn:hover {
    background: rgba(255, 255, 255, 0.25);
  }
  .lb-close {
    top: 1rem;
    right: 1rem;
  }
  .lb-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-counter {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.12);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
  }
  .lb-help {
    position: absolute;
    bottom: 1.25rem;
    right: 1.25rem;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.75rem;
  }
  @media (max-width: 640px) {
    .lb-help {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-img,
    .lb-image {
      transition: none;
    }
  }
</style>

<script>
  function initGallery(root: HTMLElement) {
    const images: string[] = JSON.parse(root.dataset.images ?? '[]');
    const main = root.querySelector<HTMLElement>('[data-gallery-main]');
    const mainImg = root.querySelector<HTMLImageElement>('[data-gallery-image]');
    const thumbs = Array.from(root.querySelectorAll<HTMLElement>('[data-gallery-thumb]'));
    const lightbox = root.querySelector<HTMLElement>('[data-lightbox]');
    if (!main || !mainImg || !lightbox) return;

    const lbImg = lightbox.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const counter = lightbox.querySelector<HTMLElement>('[data-lightbox-counter]');
    const prevBtn = lightbox.querySelector<HTMLElement>('[data-lightbox-prev]');
    const nextBtn = lightbox.querySelector<HTMLElement>('[data-lightbox-next]');
    const closeBtn = lightbox.querySelector<HTMLElement>('[data-lightbox-close]');
    if (!lbImg) return;

    const total = images.length || 1;
    let index = 0;
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    function setIndex(next: number) {
      index = (next + total) % total;
      const src = images[index];
      mainImg!.src = src;
      lbImg!.src = src;
      resetZoom();
      thumbs.forEach((t, i) => {
        t.classList.toggle('border-neutral-900', i === index);
        t.classList.toggle('border-transparent', i !== index);
        t.classList.toggle('hover:border-neutral-300', i !== index);
      });
      if (counter) counter.textContent = `${index + 1} / ${total}`;
    }

    // ---- Zoom on hover (desktop) ----
    if (canHover) {
      main.addEventListener('mousemove', (e) => {
        const rect = main.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        mainImg!.style.transformOrigin = `${x}% ${y}%`;
        mainImg!.style.transform = 'scale(2.4)';
      });
      main.addEventListener('mouseleave', () => {
        mainImg!.style.transform = '';
      });
    }

    // ---- Lightbox ----
    let scale = 1;
    let tx = 0;
    let ty = 0;
    let dragging = false;
    let startX = 0;
    let startY = 0;
    let moved = false;

    function applyTransform() {
      lbImg!.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
    }

    function resetZoom() {
      scale = 1;
      tx = 0;
      ty = 0;
      moved = false;
      lbImg!.classList.remove('is-zoomed', 'is-dragging');
      applyTransform();
    }

    function openLightbox() {
      lightbox!.classList.add('is-open');
      lightbox!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      resetZoom();
    }

    function closeLightbox() {
      lightbox!.classList.remove('is-open');
      lightbox!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      resetZoom();
    }

    main.addEventListener('click', openLightbox);
    main.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLightbox();
      }
    });

    thumbs.forEach((t) =>
      t.addEventListener('click', () => setIndex(Number(t.dataset.index ?? 0))),
    );

    prevBtn?.addEventListener('click', () => setIndex(index - 1));
    nextBtn?.addEventListener('click', () => setIndex(index + 1));
    closeBtn?.addEventListener('click', closeLightbox);

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') setIndex(index - 1);
      if (e.key === 'ArrowRight') setIndex(index + 1);
    });

    // Zoom in/out al hacer clic, y paneo al arrastrar (pointer events)
    lbImg.addEventListener('pointerdown', (e) => {
      if (scale === 1) return;
      dragging = true;
      moved = false;
      startX = e.clientX - tx;
      startY = e.clientY - ty;
      lbImg.classList.add('is-dragging');
      lbImg.setPointerCapture(e.pointerId);
    });

    lbImg.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      moved = true;
      tx = e.clientX - startX;
      ty = e.clientY - startY;
      applyTransform();
    });

    lbImg.addEventListener('pointerup', (e) => {
      if (dragging) {
        dragging = false;
        lbImg.classList.remove('is-dragging');
        lbImg.releasePointerCapture?.(e.pointerId);
      }
    });

    lbImg.addEventListener('click', (e) => {
      if (scale === 1) {
        const rect = lbImg.getBoundingClientRect();
        const px = e.clientX - (rect.left + rect.width / 2);
        const py = e.clientY - (rect.top + rect.height / 2);
        scale = 2.6;
        tx = -(scale - 1) * px;
        ty = -(scale - 1) * py;
        lbImg.classList.add('is-zoomed');
        applyTransform();
      } else if (!moved) {
        resetZoom();
      }
      moved = false;
    });
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
</script>
