# ============================================================================
#  Proxy OAuth de Decap CMS — ManáPets
#
#  Copiá este archivo a "proxy/.env" y completá los valores:
#      cp proxy/.env.example proxy/.env
#
#  El archivo .env NO se sube al repositorio (está en .gitignore).
#  El client_secret es la ÚNICA cosa que nunca puede estar en el navegador.
# ============================================================================

# Client ID de la OAuth App de GitHub
#   GitHub → Settings → Developer settings → OAuth Apps → tu app
GITHUB_CLIENT_ID=Ov23liDYsXXSSFwXOtZ2

# Client Secret de la misma OAuth App (NUNCA va en el panel ni en el repo)
GITHUB_CLIENT_SECRET=PEGÁ_AQUÍ_TU_CLIENT_SECRET

# Origen(es) del panel que pueden pedir un token, separados por coma.
# Tiene que ser el origen EXACTO con el que se abre el panel.
#   - Si el panel está en GitHub Pages:  https://manapets.github.io
#   - Si está en tu dominio:             https://manapetshop.webbot.ar
#   - Si lo probás en local:             http://localhost:4321
ALLOWED_ORIGINS=https://manapets.github.io

# Origen público de ESTE proxy, sin barra final.
# Tiene que coincidir con la Redirect URI de la OAuth App:
#   <BASE_URL>/auth/callback
BASE_URL=https://proxy.webbot.ar

# Puerto local donde escucha el servicio.
PORT=8082
