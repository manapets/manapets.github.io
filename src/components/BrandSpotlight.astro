---
import type { CollectionEntry } from 'astro:content';
import ProductCard from './ProductCard.astro';

interface Props {
  brand: string;
  slug: string;
  products: CollectionEntry<'products'>[];
}

const { brand, slug, products } = Astro.props;
---

<section class="container-page py-10">
  <div class="overflow-hidden rounded-[var(--radius-xl)] border border-border bg-white">
    <div class="flex flex-col items-start justify-between gap-4 border-b border-border bg-surface-dark p-6 sm:flex-row sm:items-center">
      <div class="flex items-center gap-4">
        <span class="pill bg-brand-primary px-4 py-2 text-base font-extrabold text-foreground">{brand}</span>
        <div>
          <h2 class="text-xl font-extrabold tracking-tight text-white">Marca destacada</h2>
          <p class="text-sm text-white/70">Nutrición de confianza, con stock permanente y entrega en el día.</p>
        </div>
      </div>
      <a href={`/productos/?marca=${slug}`} class="btn-yellow shrink-0">Ver todos los {brand}</a>
    </div>

    <div class="grid grid-cols-2 gap-4 p-4 sm:grid-cols-3 lg:grid-cols-5">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </div>
</section>
