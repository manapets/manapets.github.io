---
import { getCollection } from 'astro:content';
import ProductCard from './ProductCard.astro';
import { BRANDS, CATEGORIES } from '../lib/nav';
import { normalize, slugifyCategory } from '../lib/catalog';

interface Props {
  title?: string;
  subtitle?: string;
  presetSpecies?: 'perro' | 'gato';
}

const { title = 'Productos', subtitle, presetSpecies = '' } = Astro.props;

const products = (await getCollection('products')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'es'),
);

const usedCategories = CATEGORIES.filter((c) =>
  products.some((p) => slugifyCategory(p.data.category) === c.slug),
);
const usedBrands = BRANDS.filter((b) =>
  products.some((p) => slugifyCategory(p.data.brand) === b.slug),
);
---

<section class="container-page py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-extrabold tracking-tight">{title}</h1>
    {subtitle && <p class="mt-1 text-sm text-muted">{subtitle}</p>}
    <p class="mt-2 text-sm text-muted"><span data-result-count>{products.length}</span> productos disponibles</p>
  </div>

  <div class="mb-6 flex flex-col gap-4 rounded-[var(--radius-xl)] border border-border bg-white p-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-wrap gap-2">
      <div class="flex flex-wrap gap-2" data-filter-species>
        <button type="button" data-value="" class="chip chip-active">Todas las especies</button>
        <button type="button" data-value="perro" class="chip">Perros</button>
        <button type="button" data-value="gato" class="chip">Gatos</button>
      </div>
      <div class="flex flex-wrap gap-2" data-filter-food>
        <button type="button" data-value="" class="chip chip-active">Cualquier tipo</button>
        <button type="button" data-value="seco" class="chip">Seco</button>
        <button type="button" data-value="humido" class="chip">Húmedo</button>
        <button type="button" data-value="kg" class="chip">Kg de regalo</button>
      </div>
    </div>

    <div class="flex flex-wrap gap-2">
      <label class="sr-only" for="filter-category">Categoría</label>
      <select id="filter-category" data-filter-category class="input max-w-[12rem] py-2">
        <option value="">Todas las categorías</option>
        {usedCategories.map((c) => <option value={c.slug}>{c.name}</option>)}
      </select>

      <label class="sr-only" for="filter-brand">Marca</label>
      <select id="filter-brand" data-filter-brand class="input max-w-[11rem] py-2">
        <option value="">Todas las marcas</option>
        {usedBrands.map((b) => <option value={b.slug}>{b.name}</option>)}
      </select>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4" data-product-grid data-preset-species={presetSpecies}>
    {
      products.map((product) => (
        <div
          data-product-item
          data-species={product.data.species}
          data-category={slugifyCategory(product.data.category)}
          data-brand={slugifyCategory(product.data.brand)}
          data-food={product.data.foodType ?? ''}
          data-promo={product.data.bonusKg && product.data.bonusKg > 0 ? 'kg' : ''}
          data-text={normalize([product.data.name, product.data.brand, product.data.category, ...product.data.tags].join(' '))}
        >
          <ProductCard product={product} eager />
        </div>
      ))
    }
  </div>

  <p data-empty-filter class="hidden py-16 text-center text-muted">
    No hay productos con esos filtros. Probá sacando alguno.
  </p>
</section>

<script>
  import { matchesCategory, slugifyCategory } from '../lib/catalog';

  const grid = document.querySelector<HTMLElement>('[data-product-grid]');
  if (grid) {
    const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-product-item]'));
    const speciesBar = document.querySelector<HTMLElement>('[data-filter-species]');
    const foodBar = document.querySelector<HTMLElement>('[data-filter-food]');
    const categorySelect = document.querySelector<HTMLSelectElement>('[data-filter-category]');
    const brandSelect = document.querySelector<HTMLSelectElement>('[data-filter-brand]');
    const countEl = document.querySelector<HTMLElement>('[data-result-count]');
    const emptyEl = document.querySelector<HTMLElement>('[data-empty-filter]');

    const normalize = (v: string) =>
      v
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();

    const state = {
      species: grid.dataset.presetSpecies ?? '',
      food: '',
      promo: '',
      category: '',
      brand: '',
      q: '',
    };

    const params = new URLSearchParams(location.search);
    if (params.get('especie')) state.species = params.get('especie') ?? '';
    if (params.get('tipo')) state.food = params.get('tipo') ?? '';
    if (params.get('promo') === 'kg') state.promo = 'kg';
    if (params.get('cat')) state.category = slugifyCategory(params.get('cat') ?? '');
    if (params.get('marca')) state.brand = slugifyCategory(params.get('marca') ?? '');
    if (params.get('q')) state.q = params.get('q') ?? '';

    function syncChips(bar: HTMLElement | null, value: string): void {
      if (!bar) return;
      bar.querySelectorAll<HTMLElement>('[data-value]').forEach((btn) => {
        btn.classList.toggle('chip-active', btn.dataset.value === value);
      });
    }

    function sync(): void {
      syncChips(speciesBar, state.species);
      syncChips(foodBar, state.food === 'kg' ? 'kg' : state.food);
      if (categorySelect) categorySelect.value = state.category;
      if (brandSelect) brandSelect.value = state.brand;
    }

    function apply(): void {
      const q = normalize(state.q);
      let visible = 0;
      items.forEach((item) => {
        const species = item.dataset.species ?? '';
        const okSpecies =
          !state.species || species === state.species || species === 'ambos';
        const okCategory = matchesCategory(item.dataset.category ?? '', state.category);
        const okBrand = !state.brand || slugifyCategory(item.dataset.brand ?? '') === state.brand;
        const okPromo = !state.promo || item.dataset.promo === state.promo;
        const okFood =
          !state.food ||
          state.food === 'kg' ||
          item.dataset.food === state.food;
        const okQuery = !q || (item.dataset.text ?? '').includes(q);
        const show = okSpecies && okCategory && okBrand && okPromo && okFood && okQuery;
        item.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      if (countEl) countEl.textContent = String(visible);
      emptyEl?.classList.toggle('hidden', visible > 0);
    }

    speciesBar?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-value]');
      if (!btn) return;
      state.species = btn.dataset.value ?? '';
      sync();
      apply();
    });

    foodBar?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-value]');
      if (!btn) return;
      const value = btn.dataset.value ?? '';
      state.promo = value === 'kg' ? 'kg' : '';
      state.food = value === 'kg' ? '' : value;
      sync();
      apply();
    });

    categorySelect?.addEventListener('change', () => {
      state.category = categorySelect.value;
      apply();
    });
    brandSelect?.addEventListener('change', () => {
      state.brand = brandSelect.value;
      apply();
    });

    sync();
    apply();
  }
</script>
