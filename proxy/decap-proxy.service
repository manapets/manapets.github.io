# Servicio systemd para el proxy OAuth de Decap CMS — ManáPets
#
# Instalación:
#   sudo cp proxy/decap-proxy.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now decap-proxy
#   sudo systemctl status decap-proxy

[Unit]
Description=Proxy OAuth de Decap CMS (backend github) — ManáPets
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fsosa
WorkingDirectory=/home/fsosa/otra_tienda/proxy
ExecStart=/usr/local/bin/node /home/fsosa/otra_tienda/proxy/server.mjs
EnvironmentFile=/home/fsosa/otra_tienda/proxy/.env
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
